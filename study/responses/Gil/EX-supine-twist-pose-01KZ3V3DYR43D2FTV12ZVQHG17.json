      {
        "stepNumber": 1,
        "description": "Lie on your back, bend your knees, rotate your hips to the right, extend your right leg, and cross your left knee over to the right side."
      },
      {
        "stepNumber": 2,
        "description": "Extend your left arm out to the side and rest your left hand on your left knee."
      },
      {
        "stepNumber": 3,
        "description": "Turn your head to the left and hold the pose for 30 seconds to 1 minute."
      },
      {
        "stepNumber": 4,
        "description": "Exhale as you release the pose, and repeat on the opposite side."
      }
