    "instructions": [
      {
        "stepNumber": 1,
        "description": "Hold one hand in front of you with the palm facing upward and your fingers relaxed and extended."
      },
      {
        "stepNumber": 2,
        "description": "Slowly move your thumb across the palm toward the base of the little finger, keeping the other fingers relaxed."
      },
      {
        "stepNumber": 3,
        "description": "Move the thumb as far across the palm as is comfortable, pause briefly, and gently feel the stretch without forcing the movement."
      },
      {
        "stepNumber": 4,
        "description": "Slowly return the thumb to its starting position and extend it outward again. Repeat for the desired number of repetitions, then switch hands."
      }
    ],
