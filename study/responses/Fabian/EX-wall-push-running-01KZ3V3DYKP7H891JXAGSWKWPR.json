      {
        "stepNumber": 1,
        "description": "Stand roughly a meter away from a wall or flat surface that you can lean against."
      },
      {
        "stepNumber": 2,
        "description": "Lean forward until your palms are flat against the wall, but leave your feet where they were."
      },
      {
        "stepNumber": 3,
        "description": "Now start to walk and then jog in place, while you are propped up against the wall with your hands."
      },
      {
        "stepNumber": 4,
        "description": "Focus on bringing your knees up higher and slowly start to increase your pace as you feel more comfortable."
      }
