  "instructions": [
    {
      "stepNumber": 1,
      "description": "Start in a standing forward bend and, as you inhale, step your right leg straight back."
    },
    {
      "stepNumber": 2,
      "description": "Lift your torso and sweep your arms out to the sides and overhead."
    },
    {
      "stepNumber": 3,
      "description": "Stay in crescent lunge pose for 30 seconds to 1 minute."
    },
    {
      "stepNumber": 4,
      "description": "Exhale, place your hands on the floor, step your left leg back, beside the right, and walk your hands back to standing forward bend."
    },
    {
      "stepNumber": 5,
      "description": "Repeat with the opposite leg."
    }
  ],
