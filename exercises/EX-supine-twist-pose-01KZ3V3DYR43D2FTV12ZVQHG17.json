  "instructions": [
    {
      "stepNumber": 1,
      "description": "Lie on your back, bend your knees, rotate your hips to the left, extend your left leg, and cross your right knee over to the left side."
    },
    {
      "stepNumber": 2,
      "description": "Extend your right arm out to the side and rest your left hand on your right knee."
    },
    {
      "stepNumber": 3,
      "description": "Turn your head to the right and hold the pose for 30 seconds to 1 minute."
    },
    {
      "stepNumber": 4,
      "description": "Exhale as you release the pose, and repeat on the opposite side."
    }
  ],
