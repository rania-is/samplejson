  "instructions": [
    {
      "stepNumber": 1,
      "description": "Lie on the floor on your stomach with your arms outstretched in a T position."
    },
    {
      "stepNumber": 2,
      "description": "Keep your chin tucked and head in line with the rest of your spine."
    },
    {
      "stepNumber": 3,
      "description": "With your thumbs up, squeeze your shoulder blades together as you move your hands outward."
    },
    {
      "stepNumber": 4,
      "description": "Don’t jut your chin out, shrug your shoulders, allow your shoulders to roll forward, or arch your lower back."
    }
  ],
