    {
      "stepNumber": 1,
      "description": "Start in a low plank position with your body in a straight line, your elbows bent and under your shoulders, and your feet hip-width apart."
    },
    {
      "stepNumber": 2,
      "description": "Keeping the tension in your abs, slowly lower one knee to the floor and then back up again."
    },
    {
      "stepNumber": 3,
      "description": "Make sure your back doesn't sag."
    },
    {
      "stepNumber": 4,
      "description": "Repeat with the other leg."
