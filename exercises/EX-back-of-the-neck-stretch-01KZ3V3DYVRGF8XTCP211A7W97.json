  "instructions": [
    {
      "stepNumber": 1,
      "description": "Sit down."
    },
    {
      "stepNumber": 2,
      "description": "Your feet should be slightly more than shoulder-width apart on the floor."
    },
    {
      "stepNumber": 3,
      "description": "Make yourself tall."
    },
    {
      "stepNumber": 4,
      "description": "Grasp the back of your head and look down."
    },
    {
      "stepNumber": 5,
      "description": "Lower both shoulders, tuck in your chin."
    },
    {
      "stepNumber": 6,
      "description": "Now bend your head forward while gently pulling your hands until you feel your chin on your chest."
    },
    {
      "stepNumber": 7,
      "description": "Breathe evenly."
    },
    {
      "stepNumber": 8,
      "description": "Feel and hold the stretch for 30 seconds."
    }
  ],
