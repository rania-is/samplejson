  "instructions": [
    {
      "stepNumber": 1,
      "description": "Kneel on one leg in front of a wall with your front foot against the wall."
    },
    {
      "stepNumber": 2,
      "description": "Use your arm to bend the knee of your back leg as much as is comfortable."
    },
    {
      "stepNumber": 3,
      "description": "Use your abs to pull your ribs down, and keep your tailbone tucked under to keep your trunk controlled."
    },
    {
      "stepNumber": 4,
      "description": "Contract the glute on your trailing-leg side in order to further stretch your hip flexors."
    }
  ],
