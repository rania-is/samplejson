  "instructions": [
    {
      "stepNumber": 1,
      "description": "Start standing with your legs shoulder-width apart."
    },
    {
      "stepNumber": 2,
      "description": "Keep the heel of your planted leg on the ground and keep that leg straight."
    },
    {
      "stepNumber": 3,
      "description": "Brace the glute on the side of your planted leg to keep your pelvis from tilting."
    },
    {
      "stepNumber": 4,
      "description": "Pull one knee tightly to your chest while keeping the other leg extended straight."
    },
    {
      "stepNumber": 5,
      "description": "Don’t bend the leg on your planted leg, come onto your toes or slouch your spine forward."
    }
  ],
