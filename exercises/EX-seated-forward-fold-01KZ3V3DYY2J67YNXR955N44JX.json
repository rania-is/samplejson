      "stepNumber": 1,
      "description": "Sit on your chair with your feet on the floor and arms by your sides."
    },
    {
      "stepNumber": 2,
      "description": "Extend your right leg out in front of you and place your heel on the floor."
    },
    {
      "stepNumber": 3,
      "description": "Keeping your leg straight, slowly bend forwards over your bent knee."
    },
    {
      "stepNumber": 4,
      "description": "You should feel a stretch in the back of your right leg."
    },
    {
      "stepNumber": 5,
      "description": "Hold this position for a few breaths and then switch sides."
    }
