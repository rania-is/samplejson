  "instructions": [
    {
      "stepNumber": 1,
      "description": "Put your hands on your heart."
    },
    {
      "stepNumber": 2,
      "description": "Breathe in and out calmly."
    },
    {
      "stepNumber": 3,
      "description": "Smile inside yourself."
    },
    {
      "stepNumber": 4,
      "description": "Now slowly open your arms and laugh louder and louder."
    },
    {
      "stepNumber": 5,
      "description": "Continue until you are standing with your arms wide open and laughing."
    },
    {
      "stepNumber": 6,
      "description": "Then slowly close your arms again and the laughter becomes quieter."
    },
    {
      "stepNumber": 7,
      "description": "Feel it inside yourself when your hands are on your heart again."
    }
  ],
